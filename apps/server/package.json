{
  "name": "@alat/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alat's server: the HTTP API for the site, the Telegram bot, and the relayer that writes AlatRegistry.",
  "license": "MIT",
  "scripts": {
    "dev": "node --import tsx --env-file-if-exists=../../.env src/main.ts",
    "start": "node --import tsx src/main.ts",
    "devtool": "node --import tsx --env-file-if-exists=../../.env src/devtool.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alat/core": "workspace:*",
    "@cosmjs/stargate": "^0.39.0",
    "@hono/node-server": "^2.1.9",
    "@qorechain/evm": "0.14.0",
    "@qorechain/qoresign": "0.2.0",
    "@qorechain/sdk": "0.14.0",
    "cosmjs-types": "0.10.1",
    "grammy": "^1.46.0",
    "hono": "^4.13.19",
    "tsx": "^4.23.15",
    "viem": "~2.53.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
