# Alat server configuration. Copy to .env (git-ignored) and fill in. Testnet only.

# Secret salt for account ids on chain: HMAC-SHA256(salt, "telegram:<id>"). 32+ characters, never change it.
ALAT_ID_SALT=
# The relayer: the only account that writes AlatRegistry. Fund it from the faucet.
ALAT_RELAYER_MNEMONIC=
# The demo owner used on /demo (optional).
ALAT_DEMO_OWNER_MNEMONIC=
# Telegram bot token from @BotFather (optional: without it the site and API still run).
BOT_TOKEN=
# Where the site is reachable; used in the links the bot sends.
ALAT_PUBLIC_URL=http://localhost:8787
PORT=8787
